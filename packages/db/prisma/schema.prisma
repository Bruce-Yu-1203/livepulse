generator client {
  provider     = "prisma-client"
  output       = "../.generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VIEWER
  HOST
  ADMIN

  @@map("user_role")
}

enum RoomStatus {
  DRAFT
  LIVE
  ENDED

  @@map("room_status")
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED

  @@map("report_status")
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @db.VarChar(120)
  username      String?          @unique @db.VarChar(30)
  email         String           @unique @db.VarChar(320)
  emailVerified Boolean          @default(false) @map("email_verified")
  image         String?          @db.VarChar(2048)
  avatarKey     String?          @map("avatar_key") @db.VarChar(512)
  role          UserRole         @default(VIEWER)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  accounts      Account[]
  sessions      Session[]
  hostedRooms   Room[]
  roomLikes     RoomLike[]
  roomMutes     RoomMute[]
  reports       Report[]
  messages      DanmakuMessage[]
  followers     UserFollow[]     @relation("followedUser")
  following     UserFollow[]     @relation("followingUser")

  @@map("users")
}

model RegistrationChallenge {
  email        String   @id @db.VarChar(320)
  username     String   @db.VarChar(30)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  codeHash     String   @map("code_hash") @db.VarChar(64)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  lastSentAt   DateTime @map("last_sent_at") @db.Timestamptz(3)
  attempts     Int      @default(0)

  @@index([expiresAt])
  @@map("registration_challenges")
}

model Room {
  id            String           @id @default(uuid()) @db.Uuid
  hostId        String           @map("host_id") @db.Uuid
  title         String           @db.VarChar(120)
  description   String           @db.VarChar(2000)
  coverImageUrl String?          @map("cover_image_url") @db.Text
  status        RoomStatus       @default(DRAFT)
  startedAt     DateTime?        @map("started_at") @db.Timestamptz(3)
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  host          User             @relation(fields: [hostId], references: [id], onDelete: Restrict)
  likes         RoomLike[]
  mutes         RoomMute[]
  reports       Report[]
  messages      DanmakuMessage[]

  @@index([hostId])
  @@index([status, createdAt, id])
  @@map("rooms")
}

model RoomLike {
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("room_likes")
}

model UserFollow {
  followerId String   @map("follower_id") @db.Uuid
  followedId String   @map("followed_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  follower   User     @relation("followingUser", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("followedUser", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
  @@map("user_follows")
}

model RoomMute {
  roomId      String   @map("room_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  mutedBy     String   @map("muted_by") @db.Uuid
  effectiveAt DateTime @default(now()) @map("effective_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([expiresAt])
  @@index([userId])
  @@map("room_mutes")
}

model DanmakuMessage {
  id              String    @id @db.Uuid
  roomId          String    @map("room_id") @db.Uuid
  authorId        String    @map("author_id") @db.Uuid
  clientMessageId String    @map("client_message_id") @db.Uuid
  text            String    @db.VarChar(200)
  acceptedAt      DateTime  @map("accepted_at") @db.Timestamptz(3)
  payloadHash     String    @map("payload_hash") @db.VarChar(64)
  kafkaPartition  Int?      @map("kafka_partition")
  kafkaOffset     BigInt?   @map("kafka_offset")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([roomId, authorId, clientMessageId])
  @@index([roomId, acceptedAt(sort: Desc), id(sort: Desc)])
  @@index([expiresAt])
  @@map("danmaku_messages")
}

model MessageTombstone {
  messageId String   @id @map("message_id") @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  deletedAt DateTime @map("deleted_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("message_tombstones")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(64)
  targetId  String   @map("target_id") @db.Uuid
  roomId    String?  @map("room_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([roomId, createdAt])
  @@map("audit_logs")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  roomId     String       @map("room_id") @db.Uuid
  messageId  String       @map("message_id") @db.Uuid
  reason     ReportReason
  details    String?      @db.VarChar(500)
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  room       Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([reporterId, messageId])
  @@index([roomId, messageId])
  @@index([status, createdAt])
  @@map("reports")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(320)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}
