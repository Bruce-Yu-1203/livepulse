generator client {
  provider     = "prisma-client"
  output       = "../.generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VIEWER
  HOST
  ADMIN

  @@map("user_role")
}

enum RoomStatus {
  DRAFT
  LIVE
  ENDED

  @@map("room_status")
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED

  @@map("report_status")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(320)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  role            UserRole         @default(VIEWER)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions RefreshSession[]
  hostedRooms     Room[]
  roomLikes       RoomLike[]
  roomMutes       RoomMute[]
  reports         Report[]
  messages        DanmakuMessage[]

  @@map("users")
}

model Room {
  id            String     @id @default(uuid()) @db.Uuid
  hostId        String     @map("host_id") @db.Uuid
  title         String     @db.VarChar(120)
  description   String     @db.VarChar(2000)
  coverImageUrl String     @map("cover_image_url") @db.VarChar(2048)
  demoVideoUrl  String     @map("demo_video_url") @db.VarChar(2048)
  status        RoomStatus @default(DRAFT)
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  host          User       @relation(fields: [hostId], references: [id], onDelete: Restrict)
  likes         RoomLike[]
  mutes         RoomMute[]
  reports       Report[]
  messages      DanmakuMessage[]

  @@index([hostId])
  @@index([status, createdAt, id])
  @@map("rooms")
}

model RoomLike {
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("room_likes")
}

model RoomMute {
  roomId      String   @map("room_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  mutedBy     String   @map("muted_by") @db.Uuid
  effectiveAt DateTime @default(now()) @map("effective_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([expiresAt])
  @@index([userId])
  @@map("room_mutes")
}

model DanmakuMessage {
  id              String    @id @db.Uuid
  roomId          String    @map("room_id") @db.Uuid
  authorId        String    @map("author_id") @db.Uuid
  clientMessageId String    @map("client_message_id") @db.Uuid
  text            String    @db.VarChar(200)
  acceptedAt      DateTime  @map("accepted_at") @db.Timestamptz(3)
  payloadHash     String    @map("payload_hash") @db.VarChar(64)
  kafkaPartition  Int?      @map("kafka_partition")
  kafkaOffset     BigInt?   @map("kafka_offset")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([roomId, authorId, clientMessageId])
  @@index([roomId, acceptedAt(sort: Desc), id(sort: Desc)])
  @@index([expiresAt])
  @@map("danmaku_messages")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(64)
  targetId  String   @map("target_id") @db.Uuid
  roomId    String?  @map("room_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([roomId, createdAt])
  @@map("audit_logs")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  roomId     String       @map("room_id") @db.Uuid
  messageId  String       @map("message_id") @db.Uuid
  reason     ReportReason
  details    String?      @db.VarChar(500)
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  room       Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([reporterId, messageId])
  @@index([roomId, messageId])
  @@index([status, createdAt])
  @@map("reports")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
