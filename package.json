{
  "name": "livepulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "db:migrate": "pnpm --filter @livepulse/db db:migrate",
    "db:seed:rooms": "pnpm --filter @livepulse/db build && node packages/db/prisma/seed-rooms.mjs",
    "db:seed": "pnpm --filter @livepulse/db build && node packages/db/prisma/seed.mjs",
    "db:stop": "docker compose -f infra/compose/compose.yml stop postgres redis",
    "db:up": "docker compose -f infra/compose/compose.yml up -d --wait postgres redis",
    "demo:down": "docker compose -f infra/compose/compose.yml down",
    "demo:up": "docker compose --env-file .env -f infra/compose/compose.yml up --build -d --wait",
    "dev:api": "pnpm --filter @livepulse/api dev",
    "dev:web": "pnpm --filter @livepulse/contracts build && pnpm --filter @livepulse/web dev",
    "format": "prettier --write \"**/*.{json,mjs,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{json,mjs,ts,tsx,yaml,yml}\"",
    "lint": "eslint .",
    "test": "vitest run --exclude packages/db/test/database.integration.test.ts --exclude apps/api/test/registration.database.integration.test.ts --exclude apps/api/test/session.database.integration.test.ts --exclude apps/api/test/rooms.database.integration.test.ts --exclude apps/api/test/follows.database.integration.test.ts --exclude apps/api/test/realtime.database.integration.test.ts --exclude apps/api/test/messages.database.integration.test.ts --exclude apps/api/test/reports.database.integration.test.ts --exclude apps/api/test/kafka.database.integration.test.ts",
    "test:db": "vitest run --no-file-parallelism packages/db/test/database.integration.test.ts apps/api/test/registration.database.integration.test.ts apps/api/test/session.database.integration.test.ts apps/api/test/rooms.database.integration.test.ts apps/api/test/follows.database.integration.test.ts apps/api/test/realtime.database.integration.test.ts apps/api/test/messages.database.integration.test.ts apps/api/test/reports.database.integration.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:running": "playwright test",
    "typecheck": "pnpm --filter @livepulse/contracts build && pnpm --filter @livepulse/db prisma:generate && pnpm --filter @livepulse/web typecheck && tsc --noEmit",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
