{
  "name": "livepulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "db:migrate": "pnpm --filter @livepulse/db db:migrate",
    "db:stop": "docker compose -f infra/compose/compose.yml stop postgres mongodb redis",
    "db:up": "docker compose -f infra/compose/compose.yml up -d --wait postgres mongodb redis",
    "dev:api": "pnpm --filter @livepulse/api dev",
    "dev:web": "pnpm --filter @livepulse/contracts build && pnpm --filter @livepulse/web dev",
    "format": "prettier --write \"**/*.{json,mjs,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{json,mjs,ts,tsx,yaml,yml}\"",
    "lint": "eslint .",
    "test": "vitest run --exclude packages/db/test/database.integration.test.ts --exclude apps/api/test/registration.database.integration.test.ts --exclude apps/api/test/session.database.integration.test.ts --exclude apps/api/test/rooms.database.integration.test.ts --exclude apps/api/test/realtime.database.integration.test.ts --exclude apps/api/test/messages.database.integration.test.ts",
    "test:db": "vitest run --no-file-parallelism packages/db/test/database.integration.test.ts apps/api/test/registration.database.integration.test.ts apps/api/test/session.database.integration.test.ts apps/api/test/rooms.database.integration.test.ts apps/api/test/realtime.database.integration.test.ts apps/api/test/messages.database.integration.test.ts",
    "typecheck": "pnpm --filter @livepulse/contracts build && pnpm --filter @livepulse/db prisma:generate && pnpm --filter @livepulse/web typecheck && tsc --noEmit",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
